# Stripe Keys
STRIPE_SECRET_KEY=sk_test_your_key_here
# Se obtiene al crear el endpoint de webhook en el Dashboard de Stripe (Developers > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here
# Simula pagos SIN llamar a Stripe, útil para probar el sitio antes de tener claves reales.
# NUNCA lo dejes en "true" en producción (se ignora igual si NODE_ENV=production).
MOCK_PAYMENTS=false

# Admin
ADMIN_PASSWORD=lakeside2024
# Genera uno único y largo, ej: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-secret

# Server
PORT=3000
NODE_ENV=development
# Dominio del FRONTEND (Netlify) en producción — ahi viven success.html/cancel.html
DOMAIN=http://localhost:3000
# Orígenes autorizados a llamar la API, separados por coma (el dominio de Netlify en producción)
ALLOWED_ORIGINS=http://localhost:3000

# URL del calendario iCal exportado desde Airbnb (Calendario > Disponibilidad > Exportar calendario)
AIRBNB_ICAL_URL=

# Tax Configuration (North Carolina)
TAX_NC_STATE=4.75
TAX_MECKLENBURG_LOCAL=2.25
TAX_OCCUPANCY=8.00
